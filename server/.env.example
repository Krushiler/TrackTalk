# Copy to server/.env. That file is not committed.
# JWT_SECRET is required. The server refuses to start when it is missing.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gms
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
JWT_REFRESH_EXPIRE_MINUTES=43200
MIN_APP_BUILD=1

# ./gradlew :server:run starts the local server on port 8080 and finishes.
# ./gradlew :server:stop shuts that process down.
# ./gradlew :server:runBackend starts port 8000 (matching gms_server); :server:stopBackend stops it.
